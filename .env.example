# ── Claude API ─────────────────────────────────────────────
# 不填写时网站以「演示模式」运行（返回示例内容，不调用模型）
ANTHROPIC_API_KEY=

# 可选：模型（默认 claude-opus-5-5）
# ANTHROPIC_MODEL=claude-opus-5-5
# 可选：思考深度 low | medium | high | xhigh | max（默认 medium）
# ANTHROPIC_EFFORT=medium
# 可选：单次回复的 max_tokens（默认 16000，思考内容也计入）
# ANTHROPIC_MAX_TOKENS=16000
# 可选：拒答时的服务端自动兜底模型，设为 off 关闭（默认开启）
# ANTHROPIC_FALLBACKS=default

# ── 运行模式 ───────────────────────────────────────────────
# 1 = 强制演示模式；0 = 强制调用模型；不填 = 有 Key 就调用模型
# MOCK_MODE=

# ── 限流（单实例内存限流，按 IP 计）────────────────────────
# RATE_LIMIT_MAX=30
# RATE_LIMIT_WINDOW_SEC=600
